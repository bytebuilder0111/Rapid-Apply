# Server-side only: where Next.js rewrites /api/* to (see next.config.ts).
# The browser never talks to this URL directly — it calls same-origin /api/*
# so the refresh-token cookie stays first-party.
BACKEND_URL=http://localhost:8000

# Reserved for a future deployment where the frontend calls the API directly
# instead of through the rewrite proxy above. Unused for now.
NEXT_PUBLIC_API_URL=http://localhost:8000
